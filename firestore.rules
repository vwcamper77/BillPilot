rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/settings/{settingId} {
      allow read, write: if isOwner(userId)
        && settingId in ["balance", "preferences", "savings"];
    }

    match /users/{userId}/settings/billing {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/income/{incomeId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/bills/{billId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/largeCosts/{largeCostId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/reminders/{reminderId} {
      allow read, write: if isOwner(userId);
    }

    match /pendingEntitlements/{entitlementId} {
      allow read, write: if false;
    }

    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
