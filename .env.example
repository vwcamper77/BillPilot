NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional unless Firebase Analytics is initialized.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional forced-copy URL for the public cash-position Google Sheet.
# Must be an https://docs.google.com/spreadsheets/d/.../copy URL.
NEXT_PUBLIC_CASH_POSITION_GOOGLE_SHEET_URL=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Dedicated non-production Firebase project used only by Playwright. Keep real
# values in .env.local or the shell environment; never commit credentials.
E2E_FIREBASE_PROJECT_ID=
E2E_FIREBASE_CLIENT_EMAIL=
E2E_FIREBASE_PRIVATE_KEY=
E2E_NEXT_PUBLIC_FIREBASE_API_KEY=
E2E_NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
E2E_NEXT_PUBLIC_FIREBASE_PROJECT_ID=
E2E_NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
E2E_NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
E2E_NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional when the test project uses Analytics or local emulators.
E2E_NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
E2E_FIRESTORE_EMULATOR_HOST=
E2E_FIREBASE_AUTH_EMULATOR_HOST=

OPENAI_API_KEY=
CRON_SECRET=
SCHEDULER_SECRET=
SUBSCRIPTION_TRIAL_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
NEXT_PUBLIC_APP_URL=
# Optional corporate ownership link. Defaults to the currently live GMBF site.
NEXT_PUBLIC_GMBF_VENTURES_URL=https://gmbf-ventures.vercel.app/
APP_URL=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_LINK_SECRET=
RESEND_WEBHOOK_SECRET=

# Reminder delivery is fail-closed. Enable only after Resend DNS/webhooks and
# privacy review are complete. Emergency disable overrides every other flag.
REMINDER_EMAILS_ENABLED=false
REMINDER_ROUTINE_ENABLED=false
REMINDER_EMAILS_EMERGENCY_DISABLED=false
# Set to the production rollout timestamp so existing accounts are not sent a
# historical welcome. Ending/expiry state checks still use authoritative data.
REMINDER_LIFECYCLE_START_AT=
REMINDER_GUIDED_COHORT_PERCENT=50
REMINDER_STALE_THRESHOLD_HOURS=24
REMINDER_TRIAL_ENDING_HOURS=48
REMINDER_SCHEDULER_LOOKBACK_MINUTES=75
REMINDER_ROUTINE_CAP_HOURS=24
REMINDER_INACTIVITY_PAUSE_DAYS=30
REMINDER_WEBHOOK_TOLERANCE_SECONDS=300

# Optional server-side access bypasses. Never expose these as NEXT_PUBLIC values.
ENTITLEMENT_BYPASS_UIDS=
ENTITLEMENT_BYPASS_EMAILS=
ADMIN_EMAILS=
FOUNDING_ACCESS_ADMIN_EMAILS=

# Authorised per-browser internal analytics suppression. Rotate COOKIE_VERSION
# to revoke every enabled browser. COOKIE_SECRET must be at least 32 characters.
INTERNAL_ANALYTICS_UIDS=
INTERNAL_ANALYTICS_COOKIE_SECRET=
INTERNAL_ANALYTICS_COOKIE_VERSION=1

# Optional production analytics integrations and deliberate test-event routing.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA4_API_SECRET=
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
META_TEST_EVENT_CODE=

# Set to the release id/timestamp after deployment; written to verified outcomes.
ANALYTICS_TRUST_VERSION=

# Server-only master key for application-level field encryption.
# Generate with: openssl rand -base64 32
# NEVER expose this to the client and NEVER commit a real value.
DATA_ENCRYPTION_MASTER_KEY=

# Canva Connect OAuth. Keep the client secret server-only. The redirect URI
# must exactly match an authorized redirect configured in Canva.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
CANVA_INTEGRATION_ENABLED=false

# Mixpanel — client-side product analytics (gated by consent).
# ClearTill defaults to the EU ingest endpoint. Override only when using an
# approved analytics proxy or a different Mixpanel residency.
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_MIXPANEL_API_HOST=https://api-eu.mixpanel.com

# Buffer GraphQL publishing. All values are server-only: never add NEXT_PUBLIC_.
# Keep CONTENT_LIVE_PUBLISHING_ENABLED=false to disable live scheduling globally.
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
BUFFER_CHANNEL_LINKEDIN=
BUFFER_CHANNEL_FACEBOOK=
BUFFER_CHANNEL_INSTAGRAM=
BUFFER_API_URL=https://api.buffer.com
CONTENT_LIVE_PUBLISHING_ENABLED=false

# Server-only Pixabay image search. Candidate URLs are review-only; approved
# images must be downloaded into controlled storage before publishing.
PIXABAY_API_KEY=
