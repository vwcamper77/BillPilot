NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

OPENAI_API_KEY=
CRON_SECRET=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA4_API_SECRET=
# Set only while collecting Measurement Protocol validation/DebugView evidence.
GA4_DEBUG=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
FOUNDING_ACCESS_ADMIN_EMAILS=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=

# Comma-separated allowlist for /admin/analytics. Separate from
# FOUNDING_ACCESS_ADMIN_EMAILS on purpose — different privilege level.
ADMIN_EMAILS=

# Server-only master key for application-level field encryption.
# Generate with: openssl rand -base64 32
# NEVER expose this to the client and NEVER commit a real value.
DATA_ENCRYPTION_MASTER_KEY=

RESEND_API_KEY=
# e.g. "ClearTill <hello@cleartill.money>" — must be a verified Resend sender.
RESEND_FROM_EMAIL=

# Post-payment auth (founding-member checkout redesign)
# Must be the exact string "false" to enable the new no-auth-first checkout.
# Unset, missing, or any other value keeps the legacy authenticated flow.
CHECKOUT_AUTH_REQUIRED=
# Absolute origin used to build the Firebase email-link action URL from
# contexts with no incoming request (the Stripe webhook). No trailing slash.
NEXT_PUBLIC_APP_URL=
# Test-only: gates app/api/test-only/access-link. Leave unset in production —
# the route 404s unconditionally when this is unset, regardless of NODE_ENV.
E2E_TEST_SECRET=
